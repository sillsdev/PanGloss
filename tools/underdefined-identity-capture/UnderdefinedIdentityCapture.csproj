<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <FieldWorksDir Condition="'$(FieldWorksDir)' == ''">/mnt/c/Program Files/SIL/FieldWorks 9</FieldWorksDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SIL.Core">
      <HintPath>$(FieldWorksDir)/SIL.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SIL.Machine">
      <HintPath>$(FieldWorksDir)/SIL.Machine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SIL.Machine.Morphology.HermitCrab">
      <HintPath>$(FieldWorksDir)/SIL.Machine.Morphology.HermitCrab.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
