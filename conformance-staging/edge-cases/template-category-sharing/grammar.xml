<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE HermitCrabInput SYSTEM "HermitCrabInput.dtd">
<HermitCrabInput>
  <Language>
    <Name>Mbalantic</Name>
    <!-- Sena-shaped pathology mimic (docs/conformance-staging-plan.md's pathology catalog):
         "many templates collapsed into shared category groups so cross-template join mixing is
         possible (template A's prefix slots + template B's suffix slots -- the d5 ordering
         dead-end class that dominates Sena's confirm cost); free-fluctuation multiplicity (one
         surface with a large analysis multiset); zero phonological rules". Invented lexemes only
         (KOLO/MBILI), not copied from any real Sena/Bantu corpus. See STAGING.md.

         Two AffixTemplates share the SAME requiredPartsOfSpeech (posV), each with its own
         disjoint pair of (optional) prefix/suffix slot rules. A foma-style lexc encoding that
         flattens every rule into one shared per-category continuation class (rather than
         preserving per-template exclusivity) can synthesize a candidate combining template A's
         prefix with template B's suffix -- exactly Sena's real d5 ordering dead-end shape. This
         fixture pins the GROUND TRUTH such a candidate must be checked against: no single
         AffixTemplate contains both rules, so the mixed word has no valid derivation and a
         conforming engine (pangloss's Morpher, or any future improved proposer) must reject it. -->
    <PartsOfSpeech>
      <PartOfSpeech id="posV"><Name>v</Name></PartOfSpeech>
    </PartsOfSpeech>
    <!-- No PhonologicalFeatureSystem/PhonologicalRuleDefinitions at all -- pure morphotactics,
         mirroring suffixing-quechua/prefixal-athabaskan's own "requires: []" precedent -- so
         RequiresDerivation mechanically derives requires: []. -->
    <CharacterDefinitionTable id="table1">
      <Name>Main</Name>
      <SegmentDefinitions>
        <SegmentDefinition id="cA"><Representations><Representation>a</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cI"><Representations><Representation>i</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cO"><Representations><Representation>o</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cB"><Representations><Representation>b</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cK"><Representations><Representation>k</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cL"><Representations><Representation>l</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cM"><Representations><Representation>m</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cP"><Representations><Representation>p</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cS"><Representations><Representation>s</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cT"><Representations><Representation>t</Representation></Representations></SegmentDefinition>
      </SegmentDefinitions>
    </CharacterDefinitionTable>
    <NaturalClasses>
      <FeatureNaturalClass id="ncAny"><Name>Any</Name></FeatureNaturalClass>
    </NaturalClasses>
    <Strata>
      <!-- Deliberately NO morphologicalRules= attribute here: all four rules (mrPfxA/mrSfxA/
           mrPfxB/mrSfxB) are referenced ONLY from their own AffixTemplate's Slot, never listed as
           free-standing stratum rules. This is load-bearing, not stylistic -- confirmed empirically
           against this repo's own engine (`pg_rules::stratum`'s `run_mrule_cascade`, the free-
           standing/un-templated rule battery, iterates only the stratum's own `morphologicalRules`
           id-list; `AffixProcessRuleDef::is_template_rule` does NOT gate that list on the analysis
           side at all, so a rule listed there is combinable with ANY other listed rule regardless
           of which template(s) it also belongs to -- listing these four here, even though each was
           already exclusively used by its own template, still let template A's prefix combine
           freely with template B's suffix (an early draft of this fixture measured this directly:
           "pakolola" parsed). Omitting the attribute is what actually makes cross-template mixing
           structurally unreachable. -->
      <Stratum
        characterDefinitionTable="table1"
        morphologicalRuleOrder="unordered"
      >
        <Name>Main</Name>
        <MorphologicalRuleDefinitions>
          <!-- Template A's prefix/suffix pair. -->
          <MorphologicalRule id="mrPfxA" requiredPartsOfSpeech="posV" outputPartOfSpeech="posV">
            <Name>pfxA</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subPfxA">
                <MorphologicalInput><PhoneticSequence id="stemPfxA"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><InsertSegments><PhoneticShape>pa</PhoneticShape></InsertSegments><CopyFromInput index="stemPfxA" /></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>PFXA</MorphemeId>
          </MorphologicalRule>
          <MorphologicalRule id="mrSfxA" requiredPartsOfSpeech="posV" outputPartOfSpeech="posV">
            <Name>sfxA</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subSfxA">
                <MorphologicalInput><PhoneticSequence id="stemSfxA"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stemSfxA" /><InsertSegments><PhoneticShape>sa</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>SFXA</MorphemeId>
          </MorphologicalRule>
          <!-- Template B's prefix/suffix pair -- disjoint literal affixes, disjoint rule ids, but
               the SAME requiredPartsOfSpeech/outputPartOfSpeech as template A's rules, exactly the
               "shared category group" the real Sena grammar collapses many templates into. -->
          <MorphologicalRule id="mrPfxB" requiredPartsOfSpeech="posV" outputPartOfSpeech="posV">
            <Name>pfxB</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subPfxB">
                <MorphologicalInput><PhoneticSequence id="stemPfxB"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><InsertSegments><PhoneticShape>ta</PhoneticShape></InsertSegments><CopyFromInput index="stemPfxB" /></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>PFXB</MorphemeId>
          </MorphologicalRule>
          <MorphologicalRule id="mrSfxB" requiredPartsOfSpeech="posV" outputPartOfSpeech="posV">
            <Name>sfxB</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subSfxB">
                <MorphologicalInput><PhoneticSequence id="stemSfxB"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stemSfxB" /><InsertSegments><PhoneticShape>la</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>SFXB</MorphemeId>
          </MorphologicalRule>
        </MorphologicalRuleDefinitions>
        <AffixTemplates>
          <AffixTemplate requiredPartsOfSpeech="posV">
            <Name>templateA</Name>
            <Slot optional="true" morphologicalRules="mrPfxA"><Name>prefixA</Name></Slot>
            <Slot optional="true" morphologicalRules="mrSfxA"><Name>suffixA</Name></Slot>
          </AffixTemplate>
          <AffixTemplate requiredPartsOfSpeech="posV">
            <Name>templateB</Name>
            <Slot optional="true" morphologicalRules="mrPfxB"><Name>prefixB</Name></Slot>
            <Slot optional="true" morphologicalRules="mrSfxB"><Name>suffixB</Name></Slot>
          </AffixTemplate>
        </AffixTemplates>
        <LexicalEntries>
          <LexicalEntry id="eKolo" partOfSpeech="posV">
            <Allomorphs><Allomorph id="aKolo"><PhoneticShape>kolo</PhoneticShape></Allomorph></Allomorphs>
            <MorphemeId>KOLO</MorphemeId>
            <Gloss>root.kolo</Gloss>
          </LexicalEntry>
          <!-- Free-fluctuation multiplicity ("the mbali shape"): two lexically distinct roots that
               happen to share one phonetic shape, both posV, so the bare surface "mbili" is
               genuinely ambiguous between them -- a large(r)-than-one analysis multiset for one
               surface, the Sena free-fluctuation pathology in miniature. -->
          <LexicalEntry id="eMbiliA" partOfSpeech="posV">
            <Allomorphs><Allomorph id="aMbiliA"><PhoneticShape>mbili</PhoneticShape></Allomorph></Allomorphs>
            <MorphemeId>MBILIA</MorphemeId>
            <Gloss>arrive</Gloss>
          </LexicalEntry>
          <LexicalEntry id="eMbiliB" partOfSpeech="posV">
            <Allomorphs><Allomorph id="aMbiliB"><PhoneticShape>mbili</PhoneticShape></Allomorph></Allomorphs>
            <MorphemeId>MBILIB</MorphemeId>
            <Gloss>count</Gloss>
          </LexicalEntry>
        </LexicalEntries>
      </Stratum>
    </Strata>
  </Language>
</HermitCrabInput>
