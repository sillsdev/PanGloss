<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE HermitCrabInput SYSTEM "HermitCrabInput.dtd">
<HermitCrabInput>
  <Language>
    <Name>SubruleMorphosyntacticGating</Name>
    <!-- Synthetic construct-shaped mimic (docs/conformance/representative-typology-basis.md
         S1.2.7 -- "Subrule-level phonological gating (SubruleGating) -- its own tagged
         phenomenon"). Invented CVC roots only, no natural-language lexemes. Representative
         typological pattern: a single phonological alternation whose environment is identical
         across two morphosyntactic contexts, but whose application is restricted to only ONE of
         them by the morphological class of the material it would apply within -- gating a
         phonological rule (not a whole morphological rule) by a required part-of-speech. The
         general phenomenon -- phonological rules whose domain of application is keyed to
         morphological structure/class rather than pure phonological environment -- is well
         established in the phonology-morphology interface literature (Zwicky, "Rules of allomorphy
         and phonology-syntax interactions"); the internal-vs-external sandhi distinction in the
         Sanskrit grammatical tradition is a classic concrete case: broadly the same phonological
         alternations apply word-internally and across compound/word boundaries, but specific
         sandhi rules are blocked or altered specifically at compound-internal boundaries (see the
         research doc's own citations).

         Structural shape: mirrors this repo's own already-staged, already-oracle-verified
         `conformance-staging/edge-cases/mpr-gated-exception` fixture's proven-safe convention (a
         MorphologicalRule's own `outputPartOfSpeech` sets the category a PhonologicalSubrule's
         `requiredPartsOfSpeech` later gates on, within the SAME stratum's synthesis chain) rather
         than gating on a bare lexical entry's own POS directly. `mrDerive` is a "zero-derivation"
         rule (CopyFromInput only, no segment change) that sets `outputPartOfSpeech="posDerived"`
         without altering the shape; `prGate`'s own subrule then fires ("p" -> "b") ONLY for a word
         that has actually passed through `mrDerive` -- root1's BARE form ("pat", no derivation) and
         its DERIVED form ("pat" -> "bat" via mrDerive + prGate) present the IDENTICAL phonological
         environment ("p" before "a") reached from two different morphosyntactic derivational
         states; only the derived one is licensed to rewrite. This is distinguished from
         constructs.txt's existing "MPR features/groups" row (already representatively covered),
         which is about MORPHOLOGICAL-rule-level MPR gating -- this fixture targets SUBRULE-level
         (PhonologicalSubrule) POS gating specifically, `CharacteristicKind::SubruleGating`'s own
         `Disposition::Proven` landing spot (gate.rs's existing partition mechanism already handles
         this faithfully -- no compiler gap; see this directory's STAGING.md and the paired
         rust/crates/pg-foma/tests/cover_subrule_morphosyntactic_gating.rs regression test, which
         pins the NON-Refuse capability verdict alongside the oracle's correct disambiguation). -->
    <PartsOfSpeech>
      <PartOfSpeech id="posRoot"><Name>root</Name></PartOfSpeech>
      <PartOfSpeech id="posDerived"><Name>derived</Name></PartOfSpeech>
    </PartsOfSpeech>
    <!-- G2a discipline (`conformance-staging/edge-cases/mpr-gated-exception`'s own authoring note):
         every segment needs a feature bundle that FULLY and UNIQUELY distinguishes it from every
         other segment, or a phonological-subrule reversal collapses feature-identical segments
         into a bracketed alternates class (e.g. "[apbt]") instead of the literal input string --
         empirically confirmed while authoring this fixture: an all-featureless (`SegmentNaturalClass`
         -only) draft produced exactly that collapse. -->
    <PhonologicalFeatureSystem>
      <SymbolicFeature id="featCons"><Name>cons</Name><Symbols><Symbol id="fConsPlus">+</Symbol><Symbol id="fConsMinus">-</Symbol></Symbols></SymbolicFeature>
      <SymbolicFeature id="featVoice"><Name>voice</Name><Symbols><Symbol id="fVoicePlus">+</Symbol><Symbol id="fVoiceMinus">-</Symbol></Symbols></SymbolicFeature>
      <SymbolicFeature id="featPlace"><Name>place</Name><Symbols><Symbol id="fPlaceBilabial">bilabial</Symbol><Symbol id="fPlaceAlveolar">alveolar</Symbol><Symbol id="fPlaceVocalic">vocalic</Symbol></Symbols></SymbolicFeature>
    </PhonologicalFeatureSystem>
    <CharacterDefinitionTable id="t1">
      <Name>Main</Name>
      <SegmentDefinitions>
        <SegmentDefinition id="ca"><Representations><Representation>a</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="fConsMinus" /><FeatureValue feature="featVoice" symbolValues="fVoicePlus" /><FeatureValue feature="featPlace" symbolValues="fPlaceVocalic" />
        </SegmentDefinition>
        <SegmentDefinition id="cp"><Representations><Representation>p</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="fConsPlus" /><FeatureValue feature="featVoice" symbolValues="fVoiceMinus" /><FeatureValue feature="featPlace" symbolValues="fPlaceBilabial" />
        </SegmentDefinition>
        <SegmentDefinition id="cb"><Representations><Representation>b</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="fConsPlus" /><FeatureValue feature="featVoice" symbolValues="fVoicePlus" /><FeatureValue feature="featPlace" symbolValues="fPlaceBilabial" />
        </SegmentDefinition>
        <SegmentDefinition id="ct"><Representations><Representation>t</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="fConsPlus" /><FeatureValue feature="featVoice" symbolValues="fVoiceMinus" /><FeatureValue feature="featPlace" symbolValues="fPlaceAlveolar" />
        </SegmentDefinition>
      </SegmentDefinitions>
    </CharacterDefinitionTable>
    <NaturalClasses>
      <FeatureNaturalClass id="ncAny"><Name>Any</Name></FeatureNaturalClass>
      <FeatureNaturalClass id="ncP"><Name>P</Name><FeatureValue feature="featCons" symbolValues="fConsPlus" /><FeatureValue feature="featVoice" symbolValues="fVoiceMinus" /><FeatureValue feature="featPlace" symbolValues="fPlaceBilabial" /></FeatureNaturalClass>
      <FeatureNaturalClass id="ncA"><Name>A</Name><FeatureValue feature="featPlace" symbolValues="fPlaceVocalic" /></FeatureNaturalClass>
    </NaturalClasses>
    <PhonologicalRuleDefinitions>
      <PhonologicalRule id="prGate">
        <Name>gatedVoicing</Name>
        <PhoneticInput><PhoneticSequence><SimpleContext naturalClass="ncP" /></PhoneticSequence></PhoneticInput>
        <PhonologicalSubrules>
          <PhonologicalSubrule requiredPartsOfSpeech="posDerived">
            <PhoneticOutput><PhoneticSequence><Segment segment="cb" /></PhoneticSequence></PhoneticOutput>
            <Environment><RightEnvironment><PhoneticTemplate><PhoneticSequence><SimpleContext naturalClass="ncA" /></PhoneticSequence></PhoneticTemplate></RightEnvironment></Environment>
          </PhonologicalSubrule>
        </PhonologicalSubrules>
      </PhonologicalRule>
    </PhonologicalRuleDefinitions>
    <Strata>
      <Stratum characterDefinitionTable="t1" morphologicalRuleOrder="linear" morphologicalRules="mrDerive" phonologicalRules="prGate">
        <Name>Main</Name>
        <MorphologicalRuleDefinitions>
          <MorphologicalRule id="mrDerive" outputPartOfSpeech="posDerived">
            <Name>zeroDerive</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subDerive">
                <MorphologicalInput>
                  <PhoneticSequence id="stem"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence>
                </MorphologicalInput>
                <MorphologicalOutput>
                  <CopyFromInput index="stem" />
                </MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>DERIVE</MorphemeId>
            <Gloss>derive</Gloss>
          </MorphologicalRule>
        </MorphologicalRuleDefinitions>
        <LexicalEntries>
          <LexicalEntry id="eRoot1" partOfSpeech="posRoot">
            <Allomorphs><Allomorph id="aRoot1"><PhoneticShape>pat</PhoneticShape></Allomorph></Allomorphs>
            <MorphemeId>ROOT1</MorphemeId>
            <Gloss>root1</Gloss>
          </LexicalEntry>
        </LexicalEntries>
      </Stratum>
    </Strata>
  </Language>
</HermitCrabInput>
