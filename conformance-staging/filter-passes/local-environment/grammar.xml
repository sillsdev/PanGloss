    </CharacterDefinitionTable>
    <NaturalClasses>
      <FeatureNaturalClass id="ncAny"><Name>Any</Name></FeatureNaturalClass>
      <SegmentNaturalClass id="ncNph"><Name>NasalPlaceholder</Name><Segment segment="cNph" /></SegmentNaturalClass>
      <FeatureNaturalClass id="ncBilabial"><Name>Bilabial</Name>
        <FeatureValue feature="featPlace" symbolValues="fPlaceBilabial" />
      </FeatureNaturalClass>
      <FeatureNaturalClass id="ncAlveolar"><Name>Alveolar</Name>
        <FeatureValue feature="featPlace" symbolValues="fPlaceAlveolar" />
      </FeatureNaturalClass>
    </NaturalClasses>
    <PhonologicalRuleDefinitions>
      <PhonologicalRule id="prNasalBilabial">
        <Name>nasalBilabial</Name>
        <PhoneticInput><PhoneticSequence><SimpleContext naturalClass="ncNph" /></PhoneticSequence></PhoneticInput>
        <PhonologicalSubrules>
          <PhonologicalSubrule>
            <PhoneticOutput><PhoneticSequence><Segment segment="cM" /></PhoneticSequence></PhoneticOutput>
            <Environment>
              <RightEnvironment><PhoneticTemplate><PhoneticSequence><SimpleContext naturalClass="ncBilabial" /></PhoneticSequence></PhoneticTemplate></RightEnvironment>
            </Environment>
          </PhonologicalSubrule>
        </PhonologicalSubrules>
      </PhonologicalRule>
      <PhonologicalRule id="prNasalAlveolar">
        <Name>nasalAlveolar</Name>
        <PhoneticInput><PhoneticSequence><SimpleContext naturalClass="ncNph" /></PhoneticSequence></PhoneticInput>
        <PhonologicalSubrules>
          <PhonologicalSubrule>
            <PhoneticOutput><PhoneticSequence><Segment segment="cN" /></PhoneticSequence></PhoneticOutput>
            <Environment>
              <RightEnvironment><PhoneticTemplate><PhoneticSequence><SimpleContext naturalClass="ncAlveolar" /></PhoneticSequence></PhoneticTemplate></RightEnvironment>
            </Environment>
          </PhonologicalSubrule>
        </PhonologicalSubrules>
      </PhonologicalRule>
    </PhonologicalRuleDefinitions>
    <Strata>
      <Stratum
        characterDefinitionTable="table1"
        morphologicalRuleOrder="unordered"
        morphologicalRules="mrNasalPfx"
        phonologicalRules="prNasalBilabial prNasalAlveolar"
      >
        <Name>Main</Name>
        <MorphologicalRuleDefinitions>
          <MorphologicalRule id="mrNasalPfx" requiredPartsOfSpeech="posV" outputPartOfSpeech="posV">
            <Name>nasalPfx</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subNasalPfx">
                <MorphologicalInput><PhoneticSequence id="stemNasalPfx"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><InsertSegments><PhoneticShape>meN</PhoneticShape></InsertSegments><CopyFromInput index="stemNasalPfx" /></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <MorphemeId>AV</MorphemeId>
          </MorphologicalRule>
        </MorphologicalRuleDefinitions>
        <LexicalEntries>
