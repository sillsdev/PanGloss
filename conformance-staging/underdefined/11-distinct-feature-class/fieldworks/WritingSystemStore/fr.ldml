      <parseLenient sample=":">[\: ∶]</parseLenient>
    </parseLenients>
    <exemplarCharacters>[a-z\u00E0\u00E2\u00E6-\u00EB\u00EE\u00EF\u00F4\u00F9\u00FB\u00FC\u00FF\u0153]</exemplarCharacters>
