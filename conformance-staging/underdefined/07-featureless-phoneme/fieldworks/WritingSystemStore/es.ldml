  <layout>
    <orientation>
      <lineOrder>top-to-bottom</lineOrder>
      <characterOrder>left-to-right</characterOrder>
    </orientation>
  </layout>
  <characters>
    <ellipsis type="final">{0}…</ellipsis>
    <ellipsis type="initial">… {0}</ellipsis>
    <ellipsis type="medial">{0}… {1}</ellipsis>
    <ellipsis type="word-final">{0}…</ellipsis>
    <ellipsis type="word-initial">… {0}</ellipsis>
    <ellipsis type="word-medial">{0}… {1}</ellipsis>
    <moreInformation>?</moreInformation>
    <parseLenients scope="general" level="lenient">
      <parseLenient sample="$">[\$＄﹩]</parseLenient>
      <parseLenient sample="%">[%％﹪ ٪]</parseLenient>
      <parseLenient sample=".">[.．․﹒ 。｡︒]</parseLenient>
      <parseLenient sample="£">[£￡ ₤]</parseLenient>
      <parseLenient sample="¥">[¥￥]</parseLenient>
      <parseLenient sample="’">['＇’ ՚ ᾽᾿ ʼ]</parseLenient>
      <parseLenient sample="‰">[‰ ؉]</parseLenient>
      <parseLenient sample="₩">[₩￦]</parseLenient>
      <parseLenient sample="₹">[₹ {Rp} {Rs}₨]</parseLenient>
    </parseLenients>
    <parseLenients scope="number" level="lenient">
      <parseLenient sample="+">[+＋﬩﹢⁺₊ ➕]</parseLenient>
      <parseLenient sample=",">[,，﹐︐ ، ٫ 、﹑､︑]</parseLenient>
      <parseLenient sample="-">[\-－﹣ ‑ ‒ −⁻₋ ➖]</parseLenient>
    </parseLenients>
    <parseLenients scope="number" level="stricter">
      <parseLenient sample=",">[,，﹐︐ ٫]</parseLenient>
      <parseLenient sample=".">[.．․﹒ ｡]</parseLenient>
    </parseLenients>
    <parseLenients scope="date" level="lenient">
      <parseLenient sample="-">[\- ‑ . /]</parseLenient>
      <parseLenient sample=":">[\: ∶]</parseLenient>
    </parseLenients>
    <exemplarCharacters>[a-z\u00E1\u00E9\u00ED\u00F1\u00F3\u00FA\u00FC]</exemplarCharacters>
    <exemplarCharacters type="auxiliary">[\u00AA\u00BA\u00E0\u00E2-\u00E8\u00EA-\u00EC\u00EE\u00EF\u00F2\u00F4\u00F6\u00F8\u00F9\u00FB\u00FD\u00FF\u0101\u0103\u0113\u0115\u012B\u012D\u014D\u014F\u0153\u016B\u016D]</exemplarCharacters>
    <exemplarCharacters type="index">[A-Z\u00D1]</exemplarCharacters>
    <exemplarCharacters type="punctuation">[!-#\&amp;-*,-/\:;?@\[-\]\u00A1\u00A7\u00AB\u00BB\u00BF\u2010\u2011\u2013\u2014\u2018\u2019\u201C\u201D\u2020\u2021\u2026\u2032\u2033]</exemplarCharacters>
    <special>
      <sil:exemplarCharacters type="numbers">[%+-.0-9\u2011\u2030]</sil:exemplarCharacters>
    </special>
  </characters>
