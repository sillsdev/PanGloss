{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pangloss why-not --expect-json input",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/candidate"
  },
  "$defs": {
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "morpheme"
      ],
      "properties": {
        "morpheme": {
          "type": "string",
          "minLength": 1
        },
        "allomorph": {
          "type": "string",
          "minLength": 1
        },
        "guid": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "entry_guid": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    }
                  ]
                },
                "msa_guid": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "candidate": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/choice"
        }
      }
    }
  }
}
