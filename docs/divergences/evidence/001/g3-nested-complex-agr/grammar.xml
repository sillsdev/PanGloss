<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE HermitCrabInput SYSTEM "HermitCrabInput.dtd">
<!-- Divergence-001 adversarial grammar G3: item-4 attempt (does PriorityUnion ever find a parse
     Add loses?), tried through a NESTED complex head feature instead of a flat symbolic one.

     Exact same "stale branch" topology as G2 (mrA/mrB/mrC/mrD, four suffixes on one root), but the
     3-symbol feature (now "pers" = 1/2/3) sits one level down inside a ComplexFeature "agr", i.e.
     RequiredHeadFeatures/OutputHeadFeatures are FeatureValue(agr containing FeatureValue(pers: X))
     instead of a bare top-level FeatureValue(num: X). Both the add and priority_union operations
     recurse identically into a Complex sub-structure when both sides are Complex (pg-featstruct
     ops.rs; C# FeatureStruct.AddImpl/PriorityUnion's FeatureStruct/FeatureStruct branch), so this
     predicts the SAME direction as G2 (Add admits, PriorityUnion refuses) one level deeper, never
     reversed. This grammar exists to empirically confirm that prediction rather than assume it. -->
<HermitCrabInput>
  <Language>
    <Name>NestedComplexAgr</Name>
    <PartsOfSpeech>
      <PartOfSpeech id="posV"><Name>v</Name></PartOfSpeech>
    </PartsOfSpeech>
    <HeadFeatures>
      <ComplexFeature id="featAgr"><Name>agr</Name></ComplexFeature>
      <SymbolicFeature id="featPers">
        <Name>pers</Name>
        <Symbols>
          <Symbol id="sym1">1</Symbol>
          <Symbol id="sym2">2</Symbol>
          <Symbol id="sym3">3</Symbol>
        </Symbols>
      </SymbolicFeature>
    </HeadFeatures>
    <CharacterDefinitionTable id="tbl">
      <Name>Main</Name>
      <SegmentDefinitions>
        <SegmentDefinition id="cV"><Representations><Representation>v</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cE"><Representations><Representation>e</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cZ"><Representations><Representation>z</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cA"><Representations><Representation>a</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cO"><Representations><Representation>o</Representation></Representations></SegmentDefinition>
        <SegmentDefinition id="cU"><Representations><Representation>u</Representation></Representations></SegmentDefinition>
      </SegmentDefinitions>
    </CharacterDefinitionTable>
    <NaturalClasses>
      <FeatureNaturalClass id="ncAny"><Name>Any</Name></FeatureNaturalClass>
    </NaturalClasses>
    <Strata>
      <Stratum characterDefinitionTable="tbl" morphologicalRules="mrA mrB mrC mrD">
        <Name>Main</Name>
        <MorphologicalRuleDefinitions>
          <MorphologicalRule id="mrA">
            <Name>a</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subA">
                <MorphologicalInput><PhoneticSequence id="stemA"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stemA" /><InsertSegments><PhoneticShape>a</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <OutputHeadFeatures><FeatureValue feature="featAgr"><FeatureValue feature="featPers" symbolValues="sym3" /></FeatureValue></OutputHeadFeatures>
            <RequiredHeadFeatures><FeatureValue feature="featAgr"><FeatureValue feature="featPers" symbolValues="sym2" /></FeatureValue></RequiredHeadFeatures>
            <MorphemeId>A</MorphemeId>
            <Gloss>A</Gloss>
          </MorphologicalRule>
          <MorphologicalRule id="mrB">
            <Name>b</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subB">
                <MorphologicalInput><PhoneticSequence id="stemB"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stemB" /><InsertSegments><PhoneticShape>o</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <OutputHeadFeatures><FeatureValue feature="featAgr"><FeatureValue feature="featPers" symbolValues="sym1" /></FeatureValue></OutputHeadFeatures>
            <MorphemeId>B</MorphemeId>
            <Gloss>B</Gloss>
          </MorphologicalRule>
          <MorphologicalRule id="mrC">
            <Name>c</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subC">
                <MorphologicalInput><PhoneticSequence id="stemC"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stemC" /><InsertSegments><PhoneticShape>u</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <OutputHeadFeatures><FeatureValue feature="featAgr"><FeatureValue feature="featPers" symbolValues="sym3" /></FeatureValue></OutputHeadFeatures>
            <RequiredHeadFeatures><FeatureValue feature="featAgr"><FeatureValue feature="featPers" symbolValues="sym1" /></FeatureValue></RequiredHeadFeatures>
            <MorphemeId>C</MorphemeId>
            <Gloss>C</Gloss>
          </MorphologicalRule>
          <MorphologicalRule id="mrD">
            <Name>d</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subD">
                <MorphologicalInput><PhoneticSequence id="stemD"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stemD" /><InsertSegments><PhoneticShape>e</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <RequiredHeadFeatures><FeatureValue feature="featAgr"><FeatureValue feature="featPers" symbolValues="sym3" /></FeatureValue></RequiredHeadFeatures>
            <MorphemeId>D</MorphemeId>
            <Gloss>D</Gloss>
          </MorphologicalRule>
        </MorphologicalRuleDefinitions>
        <LexicalEntries>
          <LexicalEntry id="eVez" partOfSpeech="posV">
            <Allomorphs><Allomorph id="aVez"><PhoneticShape>vez</PhoneticShape></Allomorph></Allomorphs>
            <MorphemeId>VEZ</MorphemeId>
            <Gloss>vez</Gloss>
          </LexicalEntry>
        </LexicalEntries>
      </Stratum>
    </Strata>
  </Language>
</HermitCrabInput>
