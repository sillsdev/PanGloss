{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FieldWorks parse analysis batch case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "index",
    "word",
    "elapsedMs",
    "capped",
    "timedOut",
    "invalidShape",
    "analyses",
    "unavailable"
  ],
  "properties": {
    "schema": {
      "const": "fieldworks-parse-analysis/v1"
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "word": {
      "type": "string"
    },
    "elapsedMs": {
      "type": "integer",
      "minimum": 0
    },
    "capped": {
      "type": "boolean"
    },
    "timedOut": {
      "type": "boolean"
    },
    "invalidShape": {
      "type": "boolean"
    },
    "analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "morphs"
        ],
        "properties": {
          "morphs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/morph"
            }
          },
          "morphSpans": {
            "description": "Present only with batch --morph-spans; see docs/parse-analysis-format.md.",
            "oneOf": [
              { "type": "null" },
              { "$ref": "#/$defs/morphSpans" }
            ]
          }
        }
      }
    },
    "unavailable": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "invalidShape": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "capped": {
            "const": false
          },
          "timedOut": {
            "const": false
          },
          "analyses": {
            "maxItems": 0
          },
          "unavailable": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segments", "offsets", "text"],
      "properties": {
        "segments": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2 },
        "offsets": { "oneOf": [{ "type": "null" }, { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2 }] },
        "text": { "type": ["string", "null"] }
      }
    },
    "spanRule": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["kind", "id", "name", "guid"],
          "properties": {
            "kind": { "type": "string" },
            "id": { "type": "string" },
            "name": { "type": ["string", "null"] },
            "guid": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "morphSpans": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "segmentCount", "morphemes", "unattributed"],
      "properties": {
        "surface": { "type": "string" },
        "segmentCount": { "type": "integer", "minimum": 0 },
        "morphemes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item", "spans", "reason", "rule"],
            "properties": {
              "item": { "type": "integer", "minimum": 0 },
              "spans": { "oneOf": [{ "type": "null" }, { "type": "array", "items": { "$ref": "#/$defs/span" } }] },
              "reason": { "type": ["string", "null"] },
              "rule": { "$ref": "#/$defs/spanRule" }
            }
          }
        },
        "unattributed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["segments", "offsets", "text", "reason", "rule"],
            "properties": {
              "segments": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2 },
              "offsets": { "oneOf": [{ "type": "null" }, { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2 }] },
              "text": { "type": ["string", "null"] },
              "reason": { "type": "string" },
              "rule": { "$ref": "#/$defs/spanRule" }
            }
          }
        }
      }
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "morph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "form",
        "msa",
        "inflType",
        "guessedString"
      ],
      "properties": {
        "form": {
          "$ref": "#/$defs/guid"
        },
        "msa": {
          "$ref": "#/$defs/guid"
        },
        "inflType": {
          "anyOf": [
            {
              "$ref": "#/$defs/guid"
            },
            {
              "type": "null"
            }
          ]
        },
        "guessedString": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
