{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pangloss.dev/schemas/fst-recipe-registry/v1.json",
  "title": "PanGloss FST recipe registry",
  "type": "object",
  "required": ["registry_version", "recipes"],
  "properties": {
    "registry_version": {"const": 1},
    "recipes": {
      "type": "array",
      "items": {"$ref": "#/$defs/recipe"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "recipe": {
      "type": "object",
      "required": [
        "id", "summary", "feature_predicates", "parameters", "plan_template",
        "constraints", "objectives", "planner_eligibility", "evidence"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "summary": {"type": "string", "minLength": 1},
        "feature_predicates": {"type": "array", "items": {"type": "string"}},
        "interaction_edges": {"type": "array", "items": {"type": "string"}},
        "parameters": {"type": "object", "additionalProperties": true},
        "plan_template": {"$ref": "#/$defs/planTemplate"},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["payload_bytes", "states", "arcs", "build_wall_ms", "proposal_p95_ms", "rejection_share", "node_reuse"]}
        },
        "planner_eligibility": {"enum": ["documented", "validated", "automated"]},
        "evidence": {"$ref": "#/$defs/evidence"}
      },
      "additionalProperties": false
    },
    "planTemplate": {
      "type": "object",
      "required": ["root", "nodes"],
      "properties": {
        "root": {"type": "string"},
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}}
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
        "kind": {"enum": ["Leaf", "Compose", "Union", "Gate", "Replace"]},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "parameters": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["trials", "correctness_gate", "cross_grammar_gate"],
      "properties": {
        "feature_extractor": {"type": "string"},
        "builder": {"type": "string"},
        "trials": {"type": "array", "items": {"$ref": "#/$defs/trial"}},
        "correctness_gate": {"type": "string"},
        "cross_grammar_gate": {"type": "string"}
      },
      "additionalProperties": false
    },
    "trial": {
      "type": "object",
      "required": ["grammar", "outcome", "wall_clock_build_ms"],
      "properties": {
        "grammar": {"type": "string"},
        "outcome": {"enum": ["adopted", "rejected", "parked", "not-run"]},
        "wall_clock_build_ms": {"type": "number", "minimum": 0},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
