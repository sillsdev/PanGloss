<?xml version="1.0" encoding="utf-8"?>
<HermitCrabInput>
  <Language>
    <Name>F7LockstepComposedToy</Name>
    <!--
      Hand-authored minimal grammar (NOT a C#-XmlLanguageWriter export  -  same rationale/precedent
      as F6ProposersToyGrammar.xml, see that file's own header for why hand-authoring is the
      established convention here) exercising the F7 required gate
      (HYBRID_FST_RUST_PLAN.md's F7 entry, "the new required gate"): a genuine word-internal
      (non-junction-conditioned) single-segment substitution rule that NEITHER the bare FST's
      junction-probed affix-surface-variant arcs (SurfacePhonology.Variants only bakes the AFFIX's
      OWN alternate surfaces, not a ROOT segment changing) NOR its root-onset deletion-junction
      mechanism (DeletionJunctions only handles the root's FIRST segment being DELETED, not any
      segment SUBSTITUTED) can subsume  -  so only ComposedPhonologyProposer/LockstepPhonologyProposer
      (default) / ChainPhonologyProposer (opt-in) can recover it.

      Rule: "s -> z / _ V" (root-final "s" voices before a following vowel). No LEFT environment
      (quirk 1: LockstepPhonologyProposer.HasNonIdentityArcs only inspects arcs from the Pinv's
      START state  -  an empty left environment means the substitution arc IS that first arc, so
      quirk 1 does NOT block this rule; the toy specifically needs Lockstep to succeed, not to
      demonstrate its own rejection quirk, which is already pinned separately on the real Indonesian
      grammar in compiler_v1.rs's own unit tests). No BoundaryMarker constraint anywhere in the rule
      (quirk 2: v1's alphabet is Segment-type only  -  a rule referencing a boundary in its
      environment is unconditionally v1-unsupported; this rule's right environment is a plain vowel
      natural class, so v1 CAN find a representative and compiles it to a real branch).

      Root "las" (bare) never triggers the rule (no following vowel)  -  BareRootSurfaces sees no
      alternation. Suffix "-i" (locative-ish) is UNDERLYINGLY JUST "i" (no boundary character)  - 
      inserting a literal "+" between morphemes is an AUTHOR CHOICE in HC (a grammar only needs one
      when some rule's own pattern references it), and this rule deliberately doesn't, so omitting
      it keeps the trie's own root-affix seam boundary-free. (Found empirically, corrected before
      finalizing: an EARLIER draft of this grammar DID insert "+i" and relied on the chain's
      "insert boundary" move to transparently satisfy the vowel environment across it  -  this
      fails, because `NaturalClass`'s loader (mirroring C# `NaturalClass.cs`'s unconditional
      `AddValue(Type, Segment)`) pins the synthetic `Type` feature to Segment-only on every
      natural-class-derived identity arc, so it can never unify with a real Boundary segment's
      Type=Boundary lane  -  confirmed by direct empirical probing, not assumed. A rule whose
      environment needs to see across a real boundary must reference the boundary explicitly,
      which is exactly quirk 2's OTHER discriminator  -  not what this toy grammar wants to
      exercise. Boundary-free suffix concatenation sidesteps the question entirely.) Synthesizing
      "las" + "-i" gives the working shape "l a s i" (no intervening boundary at all); the rule's
      environment (a plain vowel natural class) matches "i" directly, firing the rule: surface
      "lazi". SurfacePhonology.Variants only probes THIS AFFIX's ("-i") own surface alternation in
      isolation  -  it never observes or bakes an arc for the ROOT's OWN segment changing, so this
      alternation is invisible to the bare FST's junction-baked arcs regardless.
    -->
    <PartsOfSpeech>
      <PartOfSpeech id="posN"><Name>n</Name></PartOfSpeech>
    </PartsOfSpeech>
    <HeadFeatures />
    <PhonologicalFeatureSystem>
      <SymbolicFeature id="featCons">
        <Name>cons</Name>
        <Symbols>
          <Symbol id="symConsP">+</Symbol>
          <Symbol id="symConsM">-</Symbol>
        </Symbols>
      </SymbolicFeature>
      <SymbolicFeature id="featVoi">
        <Name>voi</Name>
        <Symbols>
          <Symbol id="symVoiP">+</Symbol>
          <Symbol id="symVoiM">-</Symbol>
        </Symbols>
      </SymbolicFeature>
      <!--
        A third feature is REQUIRED: with only cons/voi (2x2=4 combinations) for 5 segments,
        at least one pair is featurally IDENTICAL (found empirically - l and z both (cons+,voi+),
        a and i both (cons-,voi+) - collapsing them to the SAME lane row in this port's
        lane-only InversePhonology arc representation, corrupting the compiled rule). "high"
        (vowel height, reused loosely as a 3rd discriminating dimension for consonants too) gives
        each of the 5 segments its own unique (cons, voi, high) triple.
      -->
      <SymbolicFeature id="featHigh">
        <Name>high</Name>
        <Symbols>
          <Symbol id="symHighP">+</Symbol>
          <Symbol id="symHighM">-</Symbol>
        </Symbols>
      </SymbolicFeature>
    </PhonologicalFeatureSystem>
    <CharacterDefinitionTable id="t1">
      <Name>Main</Name>
      <SegmentDefinitions>
        <SegmentDefinition id="cL">
          <Representations><Representation>l</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="symConsP" />
          <FeatureValue feature="featVoi" symbolValues="symVoiP" />
          <FeatureValue feature="featHigh" symbolValues="symHighP" />
        </SegmentDefinition>
        <SegmentDefinition id="cA">
          <Representations><Representation>a</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="symConsM" />
          <FeatureValue feature="featVoi" symbolValues="symVoiP" />
          <FeatureValue feature="featHigh" symbolValues="symHighM" />
        </SegmentDefinition>
        <SegmentDefinition id="cS">
          <Representations><Representation>s</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="symConsP" />
          <FeatureValue feature="featVoi" symbolValues="symVoiM" />
          <FeatureValue feature="featHigh" symbolValues="symHighP" />
        </SegmentDefinition>
        <SegmentDefinition id="cZ">
          <Representations><Representation>z</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="symConsP" />
          <FeatureValue feature="featVoi" symbolValues="symVoiP" />
          <FeatureValue feature="featHigh" symbolValues="symHighM" />
        </SegmentDefinition>
        <SegmentDefinition id="cI">
          <Representations><Representation>i</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="symConsM" />
          <FeatureValue feature="featVoi" symbolValues="symVoiP" />
          <FeatureValue feature="featHigh" symbolValues="symHighP" />
        </SegmentDefinition>
      </SegmentDefinitions>
      <BoundaryDefinitions>
        <BoundaryDefinition id="cPlus"><Representations><Representation>+</Representation></Representations></BoundaryDefinition>
      </BoundaryDefinitions>
    </CharacterDefinitionTable>
    <NaturalClasses>
      <FeatureNaturalClass id="ncS">
        <Name>S</Name>
        <FeatureValue feature="featCons" symbolValues="symConsP" />
        <FeatureValue feature="featVoi" symbolValues="symVoiM" />
      </FeatureNaturalClass>
      <!-- RHS: pins BOTH voi+ and high- so applying it to "s" (cons+,voi-,high+) always yields
           EXACTLY "z"'s own triple (cons+,voi+,high-), never colliding with "l" (cons+,voi+,high+). -->
      <FeatureNaturalClass id="ncZOutput">
        <Name>ZOutput</Name>
        <FeatureValue feature="featVoi" symbolValues="symVoiP" />
        <FeatureValue feature="featHigh" symbolValues="symHighM" />
      </FeatureNaturalClass>
      <FeatureNaturalClass id="ncVowel">
        <Name>V</Name>
        <FeatureValue feature="featCons" symbolValues="symConsM" />
      </FeatureNaturalClass>
      <SegmentNaturalClass id="ncAll">
        <Name>All</Name>
        <Segment segment="cL" /><Segment segment="cA" /><Segment segment="cS" /><Segment segment="cZ" /><Segment segment="cI" />
      </SegmentNaturalClass>
    </NaturalClasses>
    <PhonologicalRuleDefinitions>
      <PhonologicalRule id="prVoicing">
        <Name>Voicing before a vowel</Name>
        <PhoneticInput><PhoneticSequence><SimpleContext naturalClass="ncS" /></PhoneticSequence></PhoneticInput>
        <PhonologicalSubrules>
          <PhonologicalSubrule>
            <PhoneticOutput><PhoneticSequence><SimpleContext naturalClass="ncZOutput" /></PhoneticSequence></PhoneticOutput>
            <Environment>
              <RightEnvironment><PhoneticTemplate><PhoneticSequence><SimpleContext naturalClass="ncVowel" /></PhoneticSequence></PhoneticTemplate></RightEnvironment>
            </Environment>
          </PhonologicalSubrule>
        </PhonologicalSubrules>
      </PhonologicalRule>
    </PhonologicalRuleDefinitions>
    <Strata>
      <Stratum characterDefinitionTable="t1" phonologicalRules="prVoicing" morphologicalRules="mrLoc">
        <Name>S</Name>
        <MorphologicalRuleDefinitions>
          <MorphologicalRule id="mrLoc" requiredPartsOfSpeech="posN" outputPartOfSpeech="posN">
            <Name>-i(LOC)</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subLoc">
                <MorphologicalInput>
                  <PhoneticSequence id="stem">
                    <OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAll" /></OptionalSegmentSequence>
                  </PhoneticSequence>
                </MorphologicalInput>
                <MorphologicalOutput>
                  <CopyFromInput index="stem" />
                  <InsertSegments><PhoneticShape>i</PhoneticShape></InsertSegments>
                </MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <Gloss>LOC</Gloss>
          </MorphologicalRule>
        </MorphologicalRuleDefinitions>
        <AffixTemplates>
          <AffixTemplate final="true">
            <Name>T1</Name>
            <Slot morphologicalRules="mrLoc"><Name>Sl1</Name></Slot>
          </AffixTemplate>
        </AffixTemplates>
        <LexicalEntries>
          <LexicalEntry id="eLas" partOfSpeech="posN">
            <Allomorphs><Allomorph id="aLas"><PhoneticShape>las</PhoneticShape></Allomorph></Allomorphs>
            <Gloss>place</Gloss>
          </LexicalEntry>
        </LexicalEntries>
      </Stratum>
    </Strata>
  </Language>
</HermitCrabInput>
