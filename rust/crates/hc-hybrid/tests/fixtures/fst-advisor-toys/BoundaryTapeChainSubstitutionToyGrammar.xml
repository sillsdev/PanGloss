<?xml version="1.0" encoding="utf-8"?>
<HermitCrabInput>
  <Language>
    <Name>BoundaryTapeChainSubstitutionToy</Name>
    <!--
      Port fixture for BoundaryTapeChainTests.cs's
      Chain_RecoversBoundaryConditionedSubstitution_AfterMorphemeJunction (I4 of
      FST_FULL_GRAMMAR_PLAN.md, "the boundary tape"). Prefix "sa+" (ends in a LITERAL boundary
      character) attaches before root "pata"; a phonological rule voices the root's own leading "p"
      -> "b", conditioned SOLELY on a preceding morpheme-boundary marker -- never on any literal
      segment. "sa+"+"pata" = "sa+pata" (boundary stripped from every observable surface) ->
      surface "sabata".

      CRITICAL authoring lesson from F7LockstepComposedToyGrammar.xml's own header: a NATURAL CLASS
      (`<SimpleContext naturalClass="...">`) unconditionally pins the synthetic Type feature to
      Segment (mirrors C# `NaturalClass.cs`'s `AddValue(Type, Segment)`), so it can NEVER match a
      real Boundary node -- this is exactly why that toy grammar had to avoid referencing a boundary
      in any rule environment at all. THIS fixture needs the OPPOSITE (a rule that DOES reference a
      boundary), so its environment uses `<BoundaryMarker boundary="cPlus">` -- a CharDef reference,
      not a natural class -- which resolves to `PatternNode::CharDef` and carries the boundary
      char-def's OWN real lanes (Type=Boundary correctly set, confirmed by reading
      hc-rules/src/rewrite.rs's `node_pins`: the `PatternNode::CharDef` arm reads
      `table.get(*cd).feature_lanes()` directly, never routing through natural-class pins at all).
    -->
    <PartsOfSpeech>
      <PartOfSpeech id="posN"><Name>n</Name></PartOfSpeech>
      <PartOfSpeech id="posV"><Name>v</Name></PartOfSpeech>
    </PartsOfSpeech>
    <HeadFeatures />
    <PhonologicalFeatureSystem>
      <SymbolicFeature id="featCons"><Name>cons</Name><Symbols><Symbol id="symConsP">+</Symbol><Symbol id="symConsM">-</Symbol></Symbols></SymbolicFeature>
      <SymbolicFeature id="featVoc"><Name>voc</Name><Symbols><Symbol id="symVocP">+</Symbol><Symbol id="symVocM">-</Symbol></Symbols></SymbolicFeature>
      <SymbolicFeature id="featPoa">
        <Name>poa</Name>
        <Symbols><Symbol id="symPoaBila">bila</Symbol><Symbol id="symPoaAlve">alve</Symbol><Symbol id="symPoaHigh">high</Symbol></Symbols>
      </SymbolicFeature>
      <SymbolicFeature id="featVoice"><Name>voice</Name><Symbols><Symbol id="symVoiceP">+</Symbol><Symbol id="symVoiceM">-</Symbol></Symbols></SymbolicFeature>
    </PhonologicalFeatureSystem>
    <CharacterDefinitionTable id="t1">
      <Name>Main</Name>
      <SegmentDefinitions>
        <SegmentDefinition id="cS"><Representations><Representation>s</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="symConsP" /><FeatureValue feature="featVoc" symbolValues="symVocM" /><FeatureValue feature="featPoa" symbolValues="symPoaAlve" /><FeatureValue feature="featVoice" symbolValues="symVoiceM" />
        </SegmentDefinition>
        <SegmentDefinition id="cA"><Representations><Representation>a</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="symConsM" /><FeatureValue feature="featVoc" symbolValues="symVocP" /><FeatureValue feature="featPoa" symbolValues="symPoaBila" /><FeatureValue feature="featVoice" symbolValues="symVoiceP" />
        </SegmentDefinition>
        <SegmentDefinition id="cP"><Representations><Representation>p</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="symConsP" /><FeatureValue feature="featVoc" symbolValues="symVocM" /><FeatureValue feature="featPoa" symbolValues="symPoaBila" /><FeatureValue feature="featVoice" symbolValues="symVoiceM" />
        </SegmentDefinition>
        <SegmentDefinition id="cT"><Representations><Representation>t</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="symConsP" /><FeatureValue feature="featVoc" symbolValues="symVocM" /><FeatureValue feature="featPoa" symbolValues="symPoaHigh" /><FeatureValue feature="featVoice" symbolValues="symVoiceM" />
        </SegmentDefinition>
        <SegmentDefinition id="cB"><Representations><Representation>b</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="symConsP" /><FeatureValue feature="featVoc" symbolValues="symVocM" /><FeatureValue feature="featPoa" symbolValues="symPoaBila" /><FeatureValue feature="featVoice" symbolValues="symVoiceP" />
        </SegmentDefinition>
      </SegmentDefinitions>
      <BoundaryDefinitions>
        <BoundaryDefinition id="cPlus"><Representations><Representation>+</Representation></Representations></BoundaryDefinition>
      </BoundaryDefinitions>
    </CharacterDefinitionTable>
    <NaturalClasses>
      <SegmentNaturalClass id="ncP"><Name>P</Name><Segment segment="cP" /></SegmentNaturalClass>
      <SegmentNaturalClass id="ncB"><Name>B</Name><Segment segment="cB" /></SegmentNaturalClass>
      <SegmentNaturalClass id="ncAll">
        <Name>All</Name>
        <Segment segment="cS" /><Segment segment="cA" /><Segment segment="cP" /><Segment segment="cT" /><Segment segment="cB" />
      </SegmentNaturalClass>
    </NaturalClasses>
    <PhonologicalRuleDefinitions>
      <PhonologicalRule id="prVoiceAfterBoundary">
        <Name>voice_after_boundary</Name>
        <PhoneticInput><PhoneticSequence><SimpleContext naturalClass="ncP" /></PhoneticSequence></PhoneticInput>
        <PhonologicalSubrules>
          <PhonologicalSubrule>
            <PhoneticOutput><PhoneticSequence><SimpleContext naturalClass="ncB" /></PhoneticSequence></PhoneticOutput>
            <Environment>
              <LeftEnvironment><PhoneticTemplate><PhoneticSequence><BoundaryMarker boundary="cPlus" /></PhoneticSequence></PhoneticTemplate></LeftEnvironment>
            </Environment>
          </PhonologicalSubrule>
        </PhonologicalSubrules>
      </PhonologicalRule>
    </PhonologicalRuleDefinitions>
    <Strata>
      <Stratum characterDefinitionTable="t1" phonologicalRules="prVoiceAfterBoundary" morphologicalRules="mrSa">
        <Name>S</Name>
        <MorphologicalRuleDefinitions>
          <MorphologicalRule id="mrSa" requiredPartsOfSpeech="posV" outputPartOfSpeech="posN">
            <Name>sa+(SA)</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subSa">
                <MorphologicalInput>
                  <PhoneticSequence id="stem"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAll" /></OptionalSegmentSequence></PhoneticSequence>
                </MorphologicalInput>
                <MorphologicalOutput><InsertSegments><PhoneticShape>sa+</PhoneticShape></InsertSegments><CopyFromInput index="stem" /></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <Gloss>SA</Gloss>
          </MorphologicalRule>
        </MorphologicalRuleDefinitions>
        <AffixTemplates>
          <AffixTemplate final="true">
            <Name>T1</Name>
            <Slot morphologicalRules="mrSa"><Name>Sl1</Name></Slot>
          </AffixTemplate>
        </AffixTemplates>
        <LexicalEntries>
          <LexicalEntry id="ePata" partOfSpeech="posV">
            <Allomorphs><Allomorph id="aPata"><PhoneticShape>pata</PhoneticShape></Allomorph></Allomorphs>
            <Gloss>pata</Gloss>
          </LexicalEntry>
        </LexicalEntries>
      </Stratum>
    </Strata>
  </Language>
</HermitCrabInput>
