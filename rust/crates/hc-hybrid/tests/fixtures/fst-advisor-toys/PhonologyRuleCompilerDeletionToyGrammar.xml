<?xml version="1.0" encoding="utf-8"?>
<HermitCrabInput>
  <Language>
    <Name>PhonologyRuleCompilerDeletionToy</Name>
    <!--
      Port fixture for PhonologyRuleCompilerTests.cs (F7's "PhonologyRuleCompilerTests ported"
      gate), covering Compile_AutoRecoversBoundaryDeletion, Compile_AutoRecoversLeftContextDeletion,
      and LockstepPhonologyProposer_CoversDeletion_WiredThroughComposite (three of C#'s six methods
      -- the other three need separate, non-interacting fixtures, see this port's test file header
      for why). One stratum, root "sag" (V) + two suffixes ("-kd"/"-dk", both V->N, no boundary
      character between root and suffix -- same established convention as
      F7LockstepComposedToyGrammar.xml, sidesteps the whole boundary-crossing question since neither
      rule's environment references a boundary): "sag"+"kd" = "sagkd" -> k_deletion_right (k->0/_d)
      -> surface "sagd"; "sag"+"dk" = "sagdk" -> k_deletion_left (k->0/d_) -> surface "sagd" too
      (same surface, different underlying route -- harmless, checked to not interact: right-rule's
      env (_d) never matches in "sagdk", left-rule's env (d_) never matches in "sagkd").
    -->
    <PartsOfSpeech>
      <PartOfSpeech id="posN"><Name>n</Name></PartOfSpeech>
      <PartOfSpeech id="posV"><Name>v</Name></PartOfSpeech>
    </PartsOfSpeech>
    <HeadFeatures />
    <PhonologicalFeatureSystem>
      <SymbolicFeature id="featCons"><Name>cons</Name><Symbols><Symbol id="symConsP">+</Symbol><Symbol id="symConsM">-</Symbol></Symbols></SymbolicFeature>
      <SymbolicFeature id="featVoc"><Name>voc</Name><Symbols><Symbol id="symVocP">+</Symbol><Symbol id="symVocM">-</Symbol></Symbols></SymbolicFeature>
      <SymbolicFeature id="featVoice"><Name>voice</Name><Symbols><Symbol id="symVoiceP">+</Symbol><Symbol id="symVoiceM">-</Symbol></Symbols></SymbolicFeature>
      <SymbolicFeature id="featPoa">
        <Name>poa</Name>
        <Symbols><Symbol id="symPoaBila">bila</Symbol><Symbol id="symPoaAlve">alve</Symbol><Symbol id="symPoaVelr">velr</Symbol></Symbols>
      </SymbolicFeature>
    </PhonologicalFeatureSystem>
    <CharacterDefinitionTable id="t1">
      <Name>Main</Name>
      <SegmentDefinitions>
        <SegmentDefinition id="cS"><Representations><Representation>s</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="symConsP" /><FeatureValue feature="featVoc" symbolValues="symVocM" />
          <FeatureValue feature="featPoa" symbolValues="symPoaAlve" /><FeatureValue feature="featVoice" symbolValues="symVoiceM" />
        </SegmentDefinition>
        <SegmentDefinition id="cA"><Representations><Representation>a</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="symConsM" /><FeatureValue feature="featVoc" symbolValues="symVocP" />
          <FeatureValue feature="featPoa" symbolValues="symPoaBila" /><FeatureValue feature="featVoice" symbolValues="symVoiceP" />
        </SegmentDefinition>
        <SegmentDefinition id="cG"><Representations><Representation>g</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="symConsP" /><FeatureValue feature="featVoc" symbolValues="symVocM" />
          <FeatureValue feature="featPoa" symbolValues="symPoaVelr" /><FeatureValue feature="featVoice" symbolValues="symVoiceP" />
        </SegmentDefinition>
        <SegmentDefinition id="cK"><Representations><Representation>k</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="symConsP" /><FeatureValue feature="featVoc" symbolValues="symVocM" />
          <FeatureValue feature="featPoa" symbolValues="symPoaVelr" /><FeatureValue feature="featVoice" symbolValues="symVoiceM" />
        </SegmentDefinition>
        <SegmentDefinition id="cD"><Representations><Representation>d</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="symConsP" /><FeatureValue feature="featVoc" symbolValues="symVocM" />
          <FeatureValue feature="featPoa" symbolValues="symPoaAlve" /><FeatureValue feature="featVoice" symbolValues="symVoiceP" />
        </SegmentDefinition>
      </SegmentDefinitions>
      <BoundaryDefinitions>
        <BoundaryDefinition id="cPlus"><Representations><Representation>+</Representation></Representations></BoundaryDefinition>
      </BoundaryDefinitions>
    </CharacterDefinitionTable>
    <NaturalClasses>
      <SegmentNaturalClass id="ncK"><Name>K</Name><Segment segment="cK" /></SegmentNaturalClass>
      <SegmentNaturalClass id="ncD"><Name>D</Name><Segment segment="cD" /></SegmentNaturalClass>
      <SegmentNaturalClass id="ncAll">
        <Name>All</Name>
        <Segment segment="cS" /><Segment segment="cA" /><Segment segment="cG" /><Segment segment="cK" /><Segment segment="cD" />
      </SegmentNaturalClass>
    </NaturalClasses>
    <PhonologicalRuleDefinitions>
      <PhonologicalRule id="prKDelR">
        <Name>k_deletion_right</Name>
        <PhoneticInput><PhoneticSequence><SimpleContext naturalClass="ncK" /></PhoneticSequence></PhoneticInput>
        <PhonologicalSubrules>
          <PhonologicalSubrule>
            <!-- no PhoneticOutput => deletion -->
            <Environment>
              <RightEnvironment><PhoneticTemplate><PhoneticSequence><SimpleContext naturalClass="ncD" /></PhoneticSequence></PhoneticTemplate></RightEnvironment>
            </Environment>
          </PhonologicalSubrule>
        </PhonologicalSubrules>
      </PhonologicalRule>
      <PhonologicalRule id="prKDelL">
        <Name>k_deletion_left</Name>
        <PhoneticInput><PhoneticSequence><SimpleContext naturalClass="ncK" /></PhoneticSequence></PhoneticInput>
        <PhonologicalSubrules>
          <PhonologicalSubrule>
            <!-- no PhoneticOutput => deletion -->
            <Environment>
              <LeftEnvironment><PhoneticTemplate><PhoneticSequence><SimpleContext naturalClass="ncD" /></PhoneticSequence></PhoneticTemplate></LeftEnvironment>
            </Environment>
          </PhonologicalSubrule>
        </PhonologicalSubrules>
      </PhonologicalRule>
    </PhonologicalRuleDefinitions>
    <Strata>
      <Stratum characterDefinitionTable="t1" phonologicalRules="prKDelR prKDelL" morphologicalRules="mrKD mrDK">
        <Name>S</Name>
        <MorphologicalRuleDefinitions>
          <MorphologicalRule id="mrKD" requiredPartsOfSpeech="posV" outputPartOfSpeech="posN">
            <Name>-kd(KD)</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subKD">
                <MorphologicalInput>
                  <PhoneticSequence id="stem"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAll" /></OptionalSegmentSequence></PhoneticSequence>
                </MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stem" /><InsertSegments><PhoneticShape>kd</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <Gloss>KD</Gloss>
          </MorphologicalRule>
          <MorphologicalRule id="mrDK" requiredPartsOfSpeech="posV" outputPartOfSpeech="posN">
            <Name>-dk(DK)</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subDK">
                <MorphologicalInput>
                  <PhoneticSequence id="stem"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAll" /></OptionalSegmentSequence></PhoneticSequence>
                </MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stem" /><InsertSegments><PhoneticShape>dk</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <Gloss>DK</Gloss>
          </MorphologicalRule>
        </MorphologicalRuleDefinitions>
        <AffixTemplates>
          <AffixTemplate final="true">
            <Name>T1</Name>
            <Slot morphologicalRules="mrKD mrDK"><Name>Sl1</Name></Slot>
          </AffixTemplate>
        </AffixTemplates>
        <LexicalEntries>
          <LexicalEntry id="eSag" partOfSpeech="posV">
            <Allomorphs><Allomorph id="aSag"><PhoneticShape>sag</PhoneticShape></Allomorph></Allomorphs>
            <Gloss>sag</Gloss>
          </LexicalEntry>
        </LexicalEntries>
      </Stratum>
    </Strata>
  </Language>
</HermitCrabInput>
