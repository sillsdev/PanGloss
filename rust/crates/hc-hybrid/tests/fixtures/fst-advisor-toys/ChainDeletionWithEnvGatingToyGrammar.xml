<?xml version="1.0" encoding="utf-8"?>
<HermitCrabInput>
  <Language>
    <Name>ChainDeletionWithEnvGatingToy</Name>
    <!--
      Port fixture for ChainDeletionEpenthesisTests.cs's Chain_RecoversWordInternalDeletion_WithEnvGating
      (I3 of FST_FULL_GRAMMAR_PLAN.md): "d -> 0 / a_a", firing mid-root with no morpheme boundary
      anywhere near it. Root+suffix (not a literal bare root -- see this port's own established
      finding, PhonologyRuleCompilerTests's port commit, on why a bare root's underlying-only-trie
      baseline is unreliable in this port); the suffix "-i" attaches at the FAR end, well past the
      deletion site, so the target window is still comfortably far from any morpheme boundary.
      Root "kadata" (k-a-d-a-t-a) + suffix "-i" = "kadatai"; the rule deletes the root's OWN
      internal "d" (between the first two a's): surface "kaatai".
    -->
    <PartsOfSpeech>
      <PartOfSpeech id="posN"><Name>n</Name></PartOfSpeech>
      <PartOfSpeech id="posV"><Name>v</Name></PartOfSpeech>
    </PartsOfSpeech>
    <HeadFeatures />
    <PhonologicalFeatureSystem>
      <SymbolicFeature id="featCons"><Name>cons</Name><Symbols><Symbol id="symConsP">+</Symbol><Symbol id="symConsM">-</Symbol></Symbols></SymbolicFeature>
      <SymbolicFeature id="featVoc"><Name>voc</Name><Symbols><Symbol id="symVocP">+</Symbol><Symbol id="symVocM">-</Symbol></Symbols></SymbolicFeature>
      <SymbolicFeature id="featPoa">
        <Name>poa</Name>
        <Symbols><Symbol id="symPoaBila">bila</Symbol><Symbol id="symPoaAlve">alve</Symbol><Symbol id="symPoaVelr">velr</Symbol><Symbol id="symPoaHigh">high</Symbol></Symbols>
      </SymbolicFeature>
    </PhonologicalFeatureSystem>
    <CharacterDefinitionTable id="t1">
      <Name>Main</Name>
      <SegmentDefinitions>
        <SegmentDefinition id="cK"><Representations><Representation>k</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="symConsP" /><FeatureValue feature="featVoc" symbolValues="symVocM" /><FeatureValue feature="featPoa" symbolValues="symPoaVelr" />
        </SegmentDefinition>
        <SegmentDefinition id="cA"><Representations><Representation>a</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="symConsM" /><FeatureValue feature="featVoc" symbolValues="symVocP" /><FeatureValue feature="featPoa" symbolValues="symPoaBila" />
        </SegmentDefinition>
        <SegmentDefinition id="cD"><Representations><Representation>d</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="symConsP" /><FeatureValue feature="featVoc" symbolValues="symVocM" /><FeatureValue feature="featPoa" symbolValues="symPoaAlve" />
        </SegmentDefinition>
        <SegmentDefinition id="cT"><Representations><Representation>t</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="symConsP" /><FeatureValue feature="featVoc" symbolValues="symVocM" /><FeatureValue feature="featPoa" symbolValues="symPoaHigh" />
        </SegmentDefinition>
        <SegmentDefinition id="cI"><Representations><Representation>i</Representation></Representations>
          <FeatureValue feature="featCons" symbolValues="symConsM" /><FeatureValue feature="featVoc" symbolValues="symVocP" /><FeatureValue feature="featPoa" symbolValues="symPoaHigh" />
        </SegmentDefinition>
      </SegmentDefinitions>
      <BoundaryDefinitions>
        <BoundaryDefinition id="cPlus"><Representations><Representation>+</Representation></Representations></BoundaryDefinition>
      </BoundaryDefinitions>
    </CharacterDefinitionTable>
    <NaturalClasses>
      <SegmentNaturalClass id="ncD"><Name>D</Name><Segment segment="cD" /></SegmentNaturalClass>
      <SegmentNaturalClass id="ncA"><Name>A</Name><Segment segment="cA" /></SegmentNaturalClass>
      <SegmentNaturalClass id="ncAll">
        <Name>All</Name>
        <Segment segment="cK" /><Segment segment="cA" /><Segment segment="cD" /><Segment segment="cT" /><Segment segment="cI" />
      </SegmentNaturalClass>
    </NaturalClasses>
    <PhonologicalRuleDefinitions>
      <PhonologicalRule id="prDDel">
        <Name>d_deletion</Name>
        <PhoneticInput><PhoneticSequence><SimpleContext naturalClass="ncD" /></PhoneticSequence></PhoneticInput>
        <PhonologicalSubrules>
          <PhonologicalSubrule>
            <!-- no PhoneticOutput => deletion -->
            <Environment>
              <LeftEnvironment><PhoneticTemplate><PhoneticSequence><SimpleContext naturalClass="ncA" /></PhoneticSequence></PhoneticTemplate></LeftEnvironment>
              <RightEnvironment><PhoneticTemplate><PhoneticSequence><SimpleContext naturalClass="ncA" /></PhoneticSequence></PhoneticTemplate></RightEnvironment>
            </Environment>
          </PhonologicalSubrule>
        </PhonologicalSubrules>
      </PhonologicalRule>
    </PhonologicalRuleDefinitions>
    <Strata>
      <Stratum characterDefinitionTable="t1" phonologicalRules="prDDel" morphologicalRules="mrI">
        <Name>S</Name>
        <MorphologicalRuleDefinitions>
          <MorphologicalRule id="mrI" requiredPartsOfSpeech="posV" outputPartOfSpeech="posN">
            <Name>-i(LOC)</Name>
            <MorphologicalSubrules>
              <MorphologicalSubrule id="subI">
                <MorphologicalInput>
                  <PhoneticSequence id="stem"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAll" /></OptionalSegmentSequence></PhoneticSequence>
                </MorphologicalInput>
                <MorphologicalOutput><CopyFromInput index="stem" /><InsertSegments><PhoneticShape>i</PhoneticShape></InsertSegments></MorphologicalOutput>
              </MorphologicalSubrule>
            </MorphologicalSubrules>
            <Gloss>LOC</Gloss>
          </MorphologicalRule>
        </MorphologicalRuleDefinitions>
        <AffixTemplates>
          <AffixTemplate final="true">
            <Name>T1</Name>
            <Slot morphologicalRules="mrI"><Name>Sl1</Name></Slot>
          </AffixTemplate>
        </AffixTemplates>
        <LexicalEntries>
          <LexicalEntry id="eKadata" partOfSpeech="posV">
            <Allomorphs><Allomorph id="aKadata"><PhoneticShape>kadata</PhoneticShape></Allomorph></Allomorphs>
            <Gloss>kadata</Gloss>
          </LexicalEntry>
        </LexicalEntries>
      </Stratum>
    </Strata>
  </Language>
</HermitCrabInput>
