</NaturalClasses>
<Strata><Stratum characterDefinitionTable="table1" morphologicalRuleOrder="unordered" morphologicalRules="PASS APPL"><Name>Main</Name>
<MorphologicalRuleDefinitions><MorphologicalRule id="PASS" requiredPartsOfSpeech="posRoot" outputPartOfSpeech="posRoot"><Name>PASS</Name><MorphologicalSubrules><MorphologicalSubrule id="w"><MorphologicalInput requiredMPRFeatures="vcB"><PhoneticSequence id="w_s"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput><MorphologicalOutput ><CopyFromInput index="w_s" /><InsertSegments><PhoneticShape>w</PhoneticShape></InsertSegments></MorphologicalOutput></MorphologicalSubrule><MorphologicalSubrule id="liw"><MorphologicalInput requiredMPRFeatures="vcB"><PhoneticSequence id="liw_s"><OptionalSegmentSequence min="0" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence><SimpleContext naturalClass="ncL" /></PhoneticSequence></MorphologicalInput><MorphologicalOutput ><CopyFromInput index="liw_s" /><InsertSegments><PhoneticShape>iw</PhoneticShape></InsertSegments></MorphologicalOutput></MorphologicalSubrule></MorphologicalSubrules><MorphemeId>PASS</MorphemeId></MorphologicalRule><MorphologicalRule id="APPL" requiredPartsOfSpeech="posRoot" outputPartOfSpeech="posRoot"><Name>APPL</Name><MorphologicalSubrules><MorphologicalSubrule id="appl"><MorphologicalInput requiredMPRFeatures="vcB"><PhoneticSequence id="appl_s"><OptionalSegmentSequence min="1" max="-1"><SimpleContext naturalClass="ncAny" /></OptionalSegmentSequence></PhoneticSequence></MorphologicalInput><MorphologicalOutput ><CopyFromInput index="appl_s" /><InsertSegments><PhoneticShape>i</PhoneticShape></InsertSegments></MorphologicalOutput></MorphologicalSubrule></MorphologicalSubrules><MorphemeId>APPL</MorphemeId></MorphologicalRule></MorphologicalRuleDefinitions>
