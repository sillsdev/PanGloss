        "{scratch}/kat.fwdata",
        "{scratch}/words.txt",
        "{scratch}/out.tsv",
        "--word-timeout-ms",
        "10000",
        "--work-cap",
        "20000000",
        "--threads",
        "1",
        "--analyses",
        "{scratch}/analyses.jsonl",
        "--stats",
        "--cache",
        "{scratch}/stats.sqlite",
        "--stats-manifest",
        "{scratch}/stats-manifest.json"
