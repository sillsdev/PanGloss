          <Symbol id="sym_cm">-</Symbol>
        </Symbols>
      </SymbolicFeature>
      <SymbolicFeature id="feat_voi">
        <Name>voi</Name>
        <Symbols>
          <Symbol id="sym_vp">+</Symbol>
          <Symbol id="sym_vm">-</Symbol>
        </Symbols>
      </SymbolicFeature>
      <SymbolicFeature id="feat_poa">
        <Name>poa</Name>
        <Symbols>
