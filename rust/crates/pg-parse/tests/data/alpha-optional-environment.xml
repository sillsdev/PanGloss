    <PhonologicalRuleDefinitions>
      <PhonologicalRule id="voice">
        <Name>agree voice</Name>
        <VariableFeatures>
          <VariableFeature id="var1" name="α" phonologicalFeature="feat_poa"/>
        </VariableFeatures>
        <PhoneticInput>
          <PhoneticSequence>
            <SimpleContext naturalClass="nc_cons">
              <AlphaVariables>
                <AlphaVariable variableFeature="var1"/>
              </AlphaVariables>
            </SimpleContext>
          </PhoneticSequence>
        </PhoneticInput>
        <PhonologicalSubrules>
          <PhonologicalSubrule>
            <PhoneticOutput>
              <PhoneticSequence>
                <SimpleContext naturalClass="nc_voiced"/>
              </PhoneticSequence>
            </PhoneticOutput>
            <Environment>
              <RightEnvironment>
                <PhoneticTemplate>
